# ============================================================================
# SPECTRA - environment configuration
# Copy to `.env` and adjust. Every value below is the development default.
# ============================================================================

APP_ENV=development
DEPLOYMENT_MODE=development           # development | production
LOG_LEVEL=INFO
LOG_FORMAT=console                    # console | json
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---------------------------------------------------------------------------
# Storage backends.  Each has an `embedded` backend (zero infrastructure,
# SQLite/filesystem based) and a distributed backend.  Switch per-store.
# ---------------------------------------------------------------------------
RELATIONAL_BACKEND=sqlite             # sqlite | postgres
VECTOR_BACKEND=embedded               # embedded | qdrant
LEXICAL_BACKEND=embedded              # embedded | opensearch
GRAPH_BACKEND=embedded                # embedded | neo4j
OBJECT_BACKEND=filesystem             # filesystem | s3
CACHE_BACKEND=memory                  # memory | redis

POSTGRES_URL=postgresql+psycopg://spectra:spectra@localhost:5432/spectra
SQLITE_URL=sqlite+aiosqlite:///./data/runtime/spectra.db
QDRANT_URL=http://localhost:6333
OPENSEARCH_URL=http://localhost:9200
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=spectra-neo4j
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=spectra
MINIO_SECRET_KEY=spectra-minio
MINIO_BUCKET=spectra
MINIO_REGION=us-east-1

DATA_DIR=./data
MODEL_DIR=./models

# ---------------------------------------------------------------------------
# Model runtime.  MODEL_PROFILE selects a VRAM budget + model set.
# ---------------------------------------------------------------------------
MODEL_PROFILE=rtx4090                 # rtx4090 | cpu | cloud
MODEL_RUNTIME=auto                    # auto | llama_cpp | vllm | ollama | openai | transformers | deterministic
GPU_VRAM_BUDGET_MB=22000              # usable VRAM ceiling (24GB card, headroom reserved)
MODEL_IDLE_EVICT_SECONDS=300
MODEL_LOAD_TIMEOUT_SECONDS=300
MODEL_CALL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=2

OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8001/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=

FAST_BRAIN_MODEL=Qwen3-8B-Q4_K_M
DEEP_BRAIN_MODEL=Qwen3-30B-A3B-Instruct-2507-Q4_K_M
VISION_MODEL=Qwen3-VL-8B-Instruct-Q4_K_M
EMBEDDING_MODEL=BAAI/bge-m3
MM_EMBEDDING_MODEL=Qwen3-VL-Embedding-2B
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
WHISPER_MODEL=large-v3
OCR_ENGINE=auto                       # auto | paddle | tesseract | none

# ---------------------------------------------------------------------------
# Agent feature flags - the Brain reads these and plans around what is off.
# ---------------------------------------------------------------------------
ENABLE_DOCUMENT_AGENT=true
ENABLE_IMAGE_AGENT=true
ENABLE_VIDEO_AGENT=true
ENABLE_AUDIO_AGENT=true
ENABLE_DATABASE_AGENT=true
ENABLE_GRAPH_AGENT=true
ENABLE_ENTITY_RESOLUTION=true
ENABLE_CLAIM_BUILDER=true
ENABLE_DISPROOF_AGENT=true
ENABLE_VERIFIER=true

FAST_MODE_ENABLED=true
DEEP_MODE_ENABLED=true

# ---------------------------------------------------------------------------
# Search budgets
# ---------------------------------------------------------------------------
FAST_MAX_TOOL_CALLS=5
FAST_MAX_LATENCY_SECONDS=3
DEEP_MAX_TOOL_CALLS=30
DEEP_MAX_LATENCY_SECONDS=60
DEEP_MAX_ITERATIONS=8
CANDIDATE_POOL_SIZE=200
RERANK_TOP_K=40
EVIDENCE_TOP_K=12
SUFFICIENCY_THRESHOLD=0.62

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES=536870912
SQL_QUERY_TIMEOUT_SECONDS=10
SQL_MAX_ROWS=500
# optional command: `clamscan --no-summary {path}`
ANTIVIRUS_HOOK=
DEFAULT_ROLE=analyst                  # admin | analyst | viewer
APPLICATION_BASE_URL=http://localhost:3001

# Mock enterprise application - data access configuration.
#
# The application is READ-ONLY and holds no data of its own: it reads exactly the
# same enterprise demo database that SPECTRA's database connector queries.
#
# Backend selection:
#   * DATABASE_URL set            -> PostgreSQL (schema `enterprise`)
#   * otherwise                   -> SQLite at ENTERPRISE_SQLITE_PATH
#
# DATABASE_URL=postgresql://spectra:spectra@localhost:5432/spectra
# ENTERPRISE_PG_SCHEMA=enterprise
ENTERPRISE_SQLITE_PATH=../../data/runtime/enterprise.db

# ===========================================================================
# SPECTRA - site configuration for the LAN / operator stack.
#
#   cp .env.example .env
#   # edit .env: replace EVERY CHANGE_ME value
#   ./scripts/deploy.sh
#
# deploy.sh refuses to run while any CHANGE_ME remains, and also rejects a
# rendered compose config that still contains one.
#
# Rules:
#   * Passwords must be URL-safe: no @ : / ? # % characters.  They are embedded
#     in connection URLs (POSTGRES_URL, REDIS_URL, ...).
#   * Datastore ports default to binding on 127.0.0.1 only.  Publish them on
#     0.0.0.0 solely if something outside this host genuinely needs them.
#   * This file is the only per-site input besides TLS material in
#     $APP_ROOT/certs and the templates in $APP_ROOT/config.
# ===========================================================================

# ---------------------------------------------------------------------------
# Release identity.  APP_VERSION must match the bundle's VERSION file.
# ---------------------------------------------------------------------------
APP_VERSION=1.0.0
APP_ROOT=/opt/spectra
COMPOSE_PROJECT_NAME=spectra
CONTAINER_PREFIX=spectra
NETWORK_NAME=spectra-net
TZ=UTC

# Hostname or IP this host is reached on from analyst workstations.
# Used to build CORS origins and the browser-facing API/application URLs.
SPECTRA_PUBLIC_HOST=CHANGE_ME_lan_hostname_or_ip

# ---------------------------------------------------------------------------
# Per-service image overrides.  Leave unset for a normal release: the compose
# file then uses spectra-<svc>:${APP_VERSION}.  deploy-patch.sh writes these
# automatically when a patch bundle replaces a single service - do not edit by
# hand unless you are pinning a rollback.
# ---------------------------------------------------------------------------
#SERVICE_API_IMAGE=
#SERVICE_WORKER_IMAGE=
#SERVICE_FRONTEND_IMAGE=
#SERVICE_MOCK_ENTERPRISE_IMAGE=

# Third-party images.  Pinned; never use a floating tag.
POSTGRES_IMAGE=postgres:16.6-alpine
QDRANT_IMAGE=qdrant/qdrant:v1.12.4
OPENSEARCH_IMAGE=opensearchproject/opensearch:2.17.1
NEO4J_IMAGE=neo4j:5.26.0-community
REDIS_IMAGE=redis:7.4-alpine
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2024-10-13T13-34-11Z
MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2024-10-08T09-37-26Z

# ---------------------------------------------------------------------------
# GPU.  Set GPU_ENABLED=1 only when the NVIDIA Container Toolkit is installed
# (`docker info | grep -i runtimes` lists "nvidia").  deploy.sh then adds
# docker-compose.lan.gpu.yml.  With GPU_ENABLED=0 set MODEL_PROFILE=cpu.
# ---------------------------------------------------------------------------
GPU_ENABLED=0
GPU_COUNT=1
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ---------------------------------------------------------------------------
# Container runtime identity.  deploy.sh chowns $APP_ROOT/data/* to match.
# ---------------------------------------------------------------------------
APP_UID=10001
APP_GID=10001
NODE_UID=1000
NODE_GID=1000
QDRANT_UID=1000
QDRANT_GID=1000
OPENSEARCH_UID=1000
OPENSEARCH_GID=1000
NEO4J_UID=7474
NEO4J_GID=7474
REDIS_UID=999
REDIS_GID=999
MINIO_UID=1000
MINIO_GID=1000

# ---------------------------------------------------------------------------
# Logging (bounded on every service).
# ---------------------------------------------------------------------------
LOG_DRIVER=json-file
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------------------------------------------------------------------------
# Published ports.  <BIND_ADDR>:<PUBLISHED_PORT> -> container port.
# ---------------------------------------------------------------------------
API_BIND_ADDR=0.0.0.0
API_PUBLISHED_PORT=8000
API_PORT=8000
API_WORKERS=1
FRONTEND_BIND_ADDR=0.0.0.0
FRONTEND_PUBLISHED_PORT=3000
FRONTEND_PORT=3000
MOCK_ENTERPRISE_BIND_ADDR=0.0.0.0
MOCK_ENTERPRISE_PUBLISHED_PORT=3001
MOCK_ENTERPRISE_PORT=3001

POSTGRES_BIND_ADDR=127.0.0.1
POSTGRES_PUBLISHED_PORT=5432
QDRANT_BIND_ADDR=127.0.0.1
QDRANT_PUBLISHED_PORT=6333
OPENSEARCH_BIND_ADDR=127.0.0.1
OPENSEARCH_PUBLISHED_PORT=9200
NEO4J_BIND_ADDR=127.0.0.1
NEO4J_HTTP_PUBLISHED_PORT=7474
NEO4J_BOLT_PUBLISHED_PORT=7687
REDIS_BIND_ADDR=127.0.0.1
REDIS_PUBLISHED_PORT=6379
MINIO_BIND_ADDR=127.0.0.1
MINIO_PUBLISHED_PORT=9000
MINIO_CONSOLE_PUBLISHED_PORT=9001

# ---------------------------------------------------------------------------
# SECRETS - every one of these must be replaced before deploy.sh will run.
# ---------------------------------------------------------------------------
POSTGRES_DB=spectra
POSTGRES_USER=spectra
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# Enterprise demo database (separate DB, `enterprise` schema) and the
# SELECT-only role the Database Agent and the mock application connect as.
ENTERPRISE_DB=spectra_enterprise
ENTERPRISE_SCHEMA=enterprise
ENTERPRISE_READONLY_USER=spectra_readonly
ENTERPRISE_READONLY_PASSWORD=CHANGE_ME_readonly_password

NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_neo4j_password

REDIS_PASSWORD=CHANGE_ME_redis_password

MINIO_ROOT_USER=CHANGE_ME_minio_access_key
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_secret_key
MINIO_BUCKET=spectra
MINIO_REGION=us-east-1

# Only used if you re-enable the OpenSearch security plugin.
OPENSEARCH_DISABLE_SECURITY=true
OPENSEARCH_ADMIN_PASSWORD=CHANGE_ME_opensearch_password

# ---------------------------------------------------------------------------
# Datastore tuning.  Sized for a single 64 GB investigation host; lower on
# smaller hardware.  OpenSearch also needs vm.max_map_count>=262144 on the host
# (verify-deployment.sh checks this).
# ---------------------------------------------------------------------------
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_WORK_MEM=16MB
OPENSEARCH_JAVA_OPTS=-Xms2g -Xmx2g
OPENSEARCH_CLUSTER_NAME=spectra
NEO4J_HEAP_INITIAL=1g
NEO4J_HEAP_MAX=2g
NEO4J_PAGECACHE=1g
REDIS_MAXMEMORY=1gb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# ---------------------------------------------------------------------------
# SPECTRA storage backends - distributed everywhere in a LAN deployment.
# ---------------------------------------------------------------------------
APP_ENV=production
DEPLOYMENT_MODE=production
RELATIONAL_BACKEND=postgres
VECTOR_BACKEND=qdrant
LEXICAL_BACKEND=opensearch
GRAPH_BACKEND=neo4j
OBJECT_BACKEND=s3
CACHE_BACKEND=redis

# Host directory holding model weights.  Defaults to $APP_ROOT/models.
#SPECTRA_MODEL_DIR=/opt/spectra/models

# ---------------------------------------------------------------------------
# Model runtime.
# ---------------------------------------------------------------------------
MODEL_PROFILE=rtx4090
MODEL_RUNTIME=auto
GPU_VRAM_BUDGET_MB=22000
MODEL_IDLE_EVICT_SECONDS=300
MODEL_LOAD_TIMEOUT_SECONDS=300
MODEL_CALL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=2

OLLAMA_BASE_URL=http://host.docker.internal:11434
VLLM_BASE_URL=http://host.docker.internal:8001/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=

FAST_BRAIN_MODEL=Qwen3-8B-Q4_K_M
DEEP_BRAIN_MODEL=Qwen3-30B-A3B-Instruct-2507-Q4_K_M
VISION_MODEL=Qwen3-VL-8B-Instruct-Q4_K_M
EMBEDDING_MODEL=BAAI/bge-m3
MM_EMBEDDING_MODEL=Qwen3-VL-Embedding-2B
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
WHISPER_MODEL=large-v3
OCR_ENGINE=auto

# ---------------------------------------------------------------------------
# Agent feature flags - the Brain plans around whatever is switched off.
# ---------------------------------------------------------------------------
ENABLE_DOCUMENT_AGENT=true
ENABLE_IMAGE_AGENT=true
ENABLE_VIDEO_AGENT=true
ENABLE_AUDIO_AGENT=true
ENABLE_DATABASE_AGENT=true
ENABLE_GRAPH_AGENT=true
ENABLE_ENTITY_RESOLUTION=true
ENABLE_HYPOTHESIS_ENGINE=true
ENABLE_DISPROOF_AGENT=true
ENABLE_VERIFIER=true
FAST_MODE_ENABLED=true
DEEP_MODE_ENABLED=true

# ---------------------------------------------------------------------------
# Search budgets.
# ---------------------------------------------------------------------------
FAST_MAX_TOOL_CALLS=5
FAST_MAX_LATENCY_SECONDS=3
DEEP_MAX_TOOL_CALLS=30
DEEP_MAX_LATENCY_SECONDS=60
DEEP_MAX_ITERATIONS=8
CANDIDATE_POOL_SIZE=200
RERANK_TOP_K=40
EVIDENCE_TOP_K=12
SUFFICIENCY_THRESHOLD=0.62

# ---------------------------------------------------------------------------
# Security.
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES=536870912
SQL_QUERY_TIMEOUT_SECONDS=10
SQL_MAX_ROWS=500
ANTIVIRUS_HOOK=
DEFAULT_ROLE=analyst
WORKER_CONCURRENCY=2

# Leave unset to serve the API over plain HTTP behind your own TLS edge.
# To terminate TLS in uvicorn using the certs in $APP_ROOT/certs:
#SPECTRA_UVICORN_EXTRA_ARGS=--ssl-certfile /app/certs/server.crt --ssl-keyfile /app/certs/server.key
#API_HEALTHCHECK_URL=https://127.0.0.1:8000/api/health

# Override only if the generated values are wrong for this site.
#CORS_ORIGINS=http://spectra.lan:3000,http://spectra.lan:3001
#APPLICATION_BASE_URL=http://spectra.lan:3001
#NEXT_PUBLIC_API_BASE_URL=http://spectra.lan:8000
